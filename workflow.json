        "jsCode": "const order = $node[\"Search Orders\"].json;\nconst product = $node[\"Get Product Details\"].json;\nconst customer = $node[\"Get Customer Email\"].json;\n\nconst invoiceHTML = `\n<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial; padding: 40px; background: #f5f5f5; }\n    .invoice { background: white; padding: 40px; max-width: 800px; margin: 0 auto; }\n    .header { text-align: center; border-bottom: 3px solid #667eea; padding-bottom: 20px; margin-bottom: 30px; }\n    .header h1 { color: #667eea; font-size: 36px; }\n    table { width: 100%; border-collapse: collapse; margin: 30px 0; }\n    th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }\n    th { background: #667eea; color: white; }\n    .total { text-align: right; font-size: 20px; font-weight: bold; color: #667eea; margin-top: 20px; }\n  </style>\n</head>\n<body>\n  <div class=\"invoice\">\n    <div class=\"header\">\n      <h1>INVOICE</h1>\n      <p>Order #${order.OrderID}</p>\n    </div>\n    \n    <p><strong>Customer:</strong> ${order.CustomerName}</p>\n    <p><strong>Email:</strong> ${customer.Email}</p>\n    <p><strong>Date:</strong> ${order.Date}</p>\n    \n    <table>\n      <tr>\n        <th>Product</th>\n        <th>SKU</th>\n        <th>Quantity</th>\n        <p><strong>Date:</strong> ${new Date().toISOString().split('T')[0]}</p>\n        <th>Price</th>\n        <th>Total</th>\n      </tr>\n      <tr>\n        <td>${product.Name}</td>\n        <td>${product.SKU}</td>\n        <td>${order.Quantity}</td>\n        <td>PKR ${product.Price}</td>\n        <td>PKR ${order.TotalAmount}</td>\n      </tr>\n    </table>\n    \n    <div class=\"total\">\n      Total: PKR ${order.TotalAmount}\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    html: invoiceHTML,\n    orderID: order.OrderID,\n    customerEmail: customer.Email,\n    customerName: order.CustomerName\n  }\n}];"
      },
