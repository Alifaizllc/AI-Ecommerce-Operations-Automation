    {
      "parameters": {
        "jsCode": "// 1. Order Data from previous Code Node\nconst order = $('Code in JavaScript1').item.json;\n\n// 2. Product Data from Search Node (Input to this node)\nconst product = $input.first().json;\n\n// 3. Safe Numbers (Convert to number to avoid NaN)\n// Agar Price/Stock empty ho to 0 maan lega\nconst price = parseFloat(product.Price) || 0;\nconst stock = parseInt(product.Stock) || 0;\nconst quantity = parseInt(order.Quantity) || 0;\n\n// 4. Calculate Total\nconst totalAmount = price * quantity;\n\n// 5. Return Clean Data for Next Steps\nreturn {\n  json: {\n    // --- Order Details ---\n    CustomerName: order.CustomerName,\n    ProductSKU: order.ProductSKU,\n    Quantity: quantity,\n    PaymentMethod: order.PaymentMethod,\n    \n    // --- Calculated Values ---\n    TotalAmount: totalAmount,\n    \n    // --- Product Details (For Updates) ---\n    ProductID: product.id,       // AirTable Update ke liye\n    ProductStock: stock,         // Stock Calculation ke liye\n    ProductWooID: product.WooID, // WooCommerce Sync ke liye\n    \n    // --- Meta Data ---\n    Date: new Date().toISOString().split('T')[0],\n    Platform: \"CRM (Live Sale)\",\n    InvoiceStatus: \"Pending\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
